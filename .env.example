# ============================================================================
# Stage 2: Diffusion LLM (dLLM) Graph Compiler Configuration
# Used by: starter/stage2_ast_to_graph_compiler.ts
# ============================================================================

# Primary API key for Inception Labs (Mercury 2 dLLM)
INCEPTION_API_KEY=your_inception_api_key_here

# OpenAI-compatible base URL and model name for the dLLM endpoint
DLLM_BASE_URL=https://api.inceptionlabs.ai/v1
DLLM_MODEL=mercury-2

# ============================================================================
# Embeddings & Fallback LLM Configuration
# Used for 1536-d vector embeddings (starter/schema_and_cte.sql) or API fallback
# ============================================================================

# OpenAI API key (used as fallback in Stage 2 or for text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (optional alternative for 1536-d embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model identifier (1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# Stage 3: PostgreSQL + pgvector Database Configuration
# Used by: starter/schema_and_cte.sql
# ============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/borealis_specs
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=borealis_specs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
